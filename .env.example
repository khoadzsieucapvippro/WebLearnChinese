# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (DO NOT COMMIT ACTUAL SECRETS)
# Project: WebLearnChinese E-Learning Platform
#
# 100% FREE-TIER ARCHITECTURE GUARDRAILS:
# - TiDB Cloud Serverless: 5GB free storage forever, zero auto-billing, no credit card required.
# - Render Free Web Services: 750 free instance hours/month, sleep after 15m inactivity.
# - GitHub Pages: 100% free static site hosting.
# =============================================================================

# -----------------------------------------------------------------------------
# 1. Server & Port Configuration
# -----------------------------------------------------------------------------
# Dynamic port assigned by Render/Cloud PaaS (defaults to 8080 locally)
PORT=8080
SERVER_FORWARD_HEADERS_STRATEGY=framework

# -----------------------------------------------------------------------------
# 2. Database Datasource Configuration (TiDB Cloud Serverless / MySQL 8.4+)
# -----------------------------------------------------------------------------
# TiDB Cloud Serverless Starter connection string (100% Free Tier, TLS mandatory).
# CRITICAL NOTE: 'connectionCollation=utf8mb4_unicode_ci' is required because the
# schema uses utf8mb4_unicode_ci while MySQL 8 / TiDB default the session to
# utf8mb4_0900_ai_ci. Without it, Flyway migrations that compare text literals
# with table columns fail with "Illegal mix of collations" (error 1267).
# The backend also enforces this via Hikari connection-init-sql, so an existing
# Render URL without the parameter still works.
#
# The old 'sessionVariables=tidb_enable_clustered_index=OFF' hint only affects
# newly created tables and is NOT a fix for an existing clustered primary key.
# V24 rebuilds VOCAB_RADICAL with an explicit NONCLUSTERED primary key instead.
#
# Replace <gateway-host>, <database>, <username>, <password> with your TiDB Cloud credentials:
SPRING_DATASOURCE_URL=jdbc:mysql://<gateway-host>.prod.aws.tidbcloud.com:4000/elearning_db?sslMode=VERIFY_IDENTITY&useSSL=true&requireSSL=true&verifyServerCertificate=true&connectionCollation=utf8mb4_unicode_ci&characterEncoding=UTF-8&serverTimezone=UTC
SPRING_DATASOURCE_USERNAME=your_cluster_prefix.root
SPRING_DATASOURCE_PASSWORD=your_tidb_cloud_password

# For local development with MySQL 8.4+ without TLS:
# SPRING_DATASOURCE_URL=jdbc:mysql://localhost:3306/elearning_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&characterEncoding=UTF-8&serverTimezone=UTC
# SPRING_DATASOURCE_USERNAME=root
# SPRING_DATASOURCE_PASSWORD=

# -----------------------------------------------------------------------------
# 3. Spring Security & JWT Authentication
# -----------------------------------------------------------------------------
# MANDATORY in production: 256-bit (minimum 32-character) random string.
# Generate with: openssl rand -base64 32
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long
JWT_EXPIRATION_MS=86400000
JWT_ISSUER=elearning-backend

# -----------------------------------------------------------------------------
# 4. CORS Cross-Origin Resource Sharing
# -----------------------------------------------------------------------------
# Explicit origins allowed to make cross-origin REST calls.
# Includes GitHub Pages production frontend alongside local dev ports.
APP_CORS_ALLOWED_ORIGINS=https://khoadzsieucapvippro.github.io,http://localhost:5500,http://127.0.0.1:5500,http://localhost:3000,http://127.0.0.1:3000
APP_CORS_ALLOWED_ORIGIN_PATTERNS=https://*.github.io

# -----------------------------------------------------------------------------
# 5. Speech Assessment Microservice Integration (Python FastAPI)
# -----------------------------------------------------------------------------
# Public HTTPS URL of the deployed FastAPI speech service on Render
SPEECH_ENGINE_LOCAL_ENABLED=true
SPEECH_SERVICE_URL=https://speech-service-xxxx.onrender.com
# For local development: http://127.0.0.1:8000

# Shared secret header token (X-Internal-Token) between Spring Boot and Python FastAPI
INTERNAL_SPEECH_TOKEN=your_shared_internal_speech_token_32_chars_minimum
SPEECH_SERVICE_TOKEN=your_shared_internal_speech_token_32_chars_minimum

# Extended timeouts for Render free-tier cold-start resilience
SPEECH_ENGINE_LOCAL_CONNECT_TIMEOUT_MS=30000
SPEECH_ENGINE_LOCAL_READ_TIMEOUT_MS=45000

# -----------------------------------------------------------------------------
# 6. Frontend Deployment Configuration (GitHub Actions / Pages)
# -----------------------------------------------------------------------------
# GitHub Actions Repository Variable (BACKEND_API_URL):
# Set in Repo Settings -> Secrets and variables -> Actions -> Variables
# BACKEND_API_URL=https://elearning-backend-xxxx.onrender.com/api/v1
