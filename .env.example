# =============================================================================
# ENVIRONMENT VARIABLES TEMPLATE (DO NOT COMMIT ACTUAL SECRETS)
# =============================================================================

# JWT Secret (MANDATORY in deployment/production; minimum 256-bit/32-character random string)
# Do NOT rely on defaults in production.
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_long

# Google Gemini API Key (Free Tier from https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=20
GEMINI_MAX_AUDIO_BYTES=5242880

# Speech Service Engine Configuration
SPEECH_ENGINE_LOCAL_ENABLED=true
SPEECH_ENGINE_LOCAL_BASE_URL=http://127.0.0.1:8000

